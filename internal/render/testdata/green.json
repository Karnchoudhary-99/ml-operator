{
  "Name": "iris-mlp-green",
  "Namespace": "default",
  "Replicas": 2,
  "Labels": {
    "app.kubernetes.io/name": "iris-mlp",
    "ml-operator/canary": "false",
    "ml-operator/green": "true",
    "ml-operator/managed-by": "ml-operator",
    "ml-operator/model": "iris-mlp",
    "ml-operator/version": "v1"
  },
  "Annotations": null,
  "Selector": {
    "app.kubernetes.io/name": "iris-mlp",
    "ml-operator/canary": "false",
    "ml-operator/green": "true",
    "ml-operator/managed-by": "ml-operator"
  },
  "Canary": false,
  "Green": true,
  "Container": {
    "Name": "model",
    "Image": "registry.example.com/iris-mlp:v1",
    "Port": 8080,
    "Env": [
      {
        "Name": "BATCH_SIZE",
        "Value": "32"
      },
      {
        "Name": "MODEL_PATH",
        "Value": "/models/iris-mlp"
      }
    ],
    "Command": null,
    "VolumeMounts": null,
    "CPURequest": "500m",
    "CPULimit": "1",
    "MemoryRequest": "512Mi",
    "MemoryLimit": "1Gi",
    "ReadinessProbe": {
      "Path": "/healthz",
      "InitialDelaySeconds": 5,
      "PeriodSeconds": 10
    },
    "Security": {
      "ReadOnlyRootFilesystem": true,
      "AllowPrivilegeEscalation": false,
      "DropCapabilities": [
        "ALL"
      ]
    }
  },
  "AntiAffinity": true,
  "PodSecurity": {
    "RunAsNonRoot": true,
    "RunAsUser": 10001,
    "SeccompProfile": "RuntimeDefault"
  },
  "TopologySpread": [
    {
      "MaxSkew": 1,
      "TopologyKey": "kubernetes.io/hostname",
      "WhenUnsatisfiable": "ScheduleAnyway",
      "LabelSelector": {
        "app.kubernetes.io/name": "iris-mlp",
        "ml-operator/managed-by": "ml-operator"
      }
    }
  ],
  "NodeSelector": null,
  "Tolerations": null,
  "ImagePullSecrets": null,
  "InitContainers": null,
  "Volumes": null
}
